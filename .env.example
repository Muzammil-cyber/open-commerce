# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Not used by `docker compose` (it points the app at its own db container).
DATABASE_URL="postgresql://username:password@localhost:5432/openfront"

# Must be at least 32 characters.
SESSION_SECRET="your-very-long-session-secret-key-here-32-chars-minimum"

# Public URL of the app, inlined at build time (no trailing slash).
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (S3-compatible). Required when NODE_ENV=production, which
# includes `docker compose`. Local compose defaults point at SeaweedFS.
# ---------------------------------------------------------------------------
S3_ENDPOINT="https://s3.example.com"
S3_BUCKET_NAME="your-bucket-name"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
# POSTGRES_USER="openfront"
# POSTGRES_PASSWORD="openfront"
# POSTGRES_DB="openfront"
# APP_PORT="3000"

# ---------------------------------------------------------------------------
# Optional - Payments
# ---------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY="sk_test_51..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_KEY="pk_test_51..."

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_WEBHOOK_ID="your-paypal-webhook-id"
NEXT_PUBLIC_PAYPAL_SANDBOX="true"

# ---------------------------------------------------------------------------
# Optional - Email
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourstore.com"
# Storefront URL used for links in emails.
SMTP_STORE_LINK="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional - AI assistant (OpenRouter)
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="anthropic/claude-sonnet-4"
# OPENROUTER_MAX_TOKENS="4000"

# ---------------------------------------------------------------------------
# Optional - Behaviour and security
# ---------------------------------------------------------------------------
# Default storefront region code (default: "us").
# NEXT_PUBLIC_DEFAULT_REGION="us"
# Allow public sign-ups on the dashboard.
# PUBLIC_SIGNUPS_ALLOWED="false"
# Hide the Openfront branding on the storefront.
# HIDE_OPENFRONT_BRANDING="false"
# Comma-separated proxy IPs whose X-Forwarded-For / X-Real-IP is trusted.
# TRUSTED_PROXY_IPS=""
# Separate secret for hashing credentials (falls back to SESSION_SECRET).
# CREDENTIAL_PEPPER=""
# Customer token lifetime in days (default: 90).
# CUSTOMER_TOKEN_MAX_AGE_DAYS="90"
